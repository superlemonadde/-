CC     = gcc
CFLAGS = -Wall -Wextra -O2

SERVER  = server_app
CLIENT  = client_app

# 公共模块（两端共用）
COMMON  = common/utils.c

# ============================================================
# 默认目标
# ============================================================
all: $(SERVER) $(CLIENT)

# ============================================================
# 编译服务端
# server.c  : 入口，创建 socket、绑定端口
# receiver.c: 文件接收逻辑
# ============================================================
$(SERVER): server/server.c server/receiver.c $(COMMON)
	$(CC) $^ -o $@ $(CFLAGS)

# ============================================================
# 编译客户端
# client.c : 入口，创建 socket、解析参数
# sender.c : 文件发送逻辑
# ============================================================
$(CLIENT): client/client.c client/sender.c $(COMMON)
	$(CC) $^ -o $@ $(CFLAGS)

# ============================================================
# 清理
# ============================================================
clean:
	rm -f $(SERVER) $(CLIENT) received.bin
